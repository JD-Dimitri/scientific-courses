# Valeurs par défaut, versionnées. Ne mets JAMAIS de vrai mot de passe ici :
# crée un fichier .env.local (ignoré par git) pour tes propres valeurs.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-moi-dans-env-local
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# MySQL ou MariaDB en local (WAMP, XAMPP, Laragon…). Adapte utilisateur, mot de passe et version.
DATABASE_URL="mysql://root:@127.0.0.1:3306/scientific_courses?serverVersion=8.0.32&charset=utf8mb4"
# Pour MariaDB : serverVersion=10.11.2-MariaDB
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Mailpit capture les e-mails en local : interface sur http://localhost:8025
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

# Adresse d'expédition des e-mails de la plateforme
MAILER_FROM=no-reply@scientific-courses.local

# Adresse du front React, utilisée dans le lien de réinitialisation du mot de passe
FRONTEND_URL=http://localhost:5173
